# Google Cloud Speech-to-Text
# Option 1: Path to service account JSON file (local development)
GOOGLE_APPLICATION_CREDENTIALS=./google-credentials.json

# Option 2: Service account JSON as a string (for deployment platforms like Vercel)
# GOOGLE_CLOUD_CREDENTIALS={"type":"service_account","project_id":"..."}

# Google Cloud Project ID
GOOGLE_CLOUD_PROJECT_ID=your-project-id

# Anthropic (Claude) - used in Phase 2+
ANTHROPIC_API_KEY=your-anthropic-api-key

# TODO: Rotate these keys - they were exposed in git history (commit ed3abb2)
